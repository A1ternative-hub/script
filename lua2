			local function Chip(host, glyph, colorKey, order)
				local sz = IS_MOB and 19 or 17
				local c = MakeButton(host, {
					Text = glyph,
					TextSize = MET.F_TINY + 1,
					Font = Enum.Font.GothamBold,
