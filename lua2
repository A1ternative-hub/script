-- Tabs take an options table. Columns = 2 gives a two-column desktop layout
-- that collapses to one column on narrow windows / phones.
local demo = win:Tab({Name = "v8 Demo", Columns = 2})

--------------------------------------------------------------------------
-- RISK / WARNING TOGGLES
--------------------------------------------------------------------------
local riskSec = demo:Section({Name = "Risky Options", Side = "Left"})

-- Risk = true  -> amber bar on the row + "!" chip (tap/hover for the reason)
-- Confirm      -> shows a confirm prompt the first time it is switched on
local flyTog = riskSec:Toggle({
Name     = "Fly",
Default  = false,
Risk     = true,
RiskText = "Fly is detected by most anticheats and can get you kicked.",
Confirm  = true,
Tooltip  = "Server-side movement, use sparingly.",
Flag     = "fly",                       -- optional stable config key
Callback = function(v) end,
})
flyTog:SetRisk(true, "Updated warning text")
print(flyTog:IsRisky())

-- Risky bind. Mode = Toggle | Hold | Always (right-click the key pill to cycle)
local rageTog = riskSec:ToggleBind({
Name     = "Rage Aim",
Key      = Enum.KeyCode.R,
Mode     = "Hold",
Risk     = true,
Confirm  = true,
Callback = function(v) end,
})
rageTog:SetMode("Toggle")
print(rageTog:GetMode(), rageTog:GetKey())

